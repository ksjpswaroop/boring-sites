---
/**
 * Terms of Service page. Generic boilerplate; customize per site.
 */
export interface Props {
  siteName: string;
  siteUrl: string;
  contactEmail: string;
  customClause?: string; // e.g. "Do not use generated phone numbers for fraud."
}

const { siteName, siteUrl, contactEmail, customClause } = Astro.props;
const lastUpdated = '2026-08-18';
---
<article class="container-prose py-12">
  <h1 class="text-4xl font-bold">Terms of Service</h1>
  <p class="mt-2 text-sm text-neutral-500">Last updated: {lastUpdated}</p>

  <div class="prose mt-8 dark:prose-invert">
    <h2>Acceptance</h2>
    <p>By using {siteName}, you agree to these terms. If you don't agree, don't use the site.</p>

    <h2>What this site is</h2>
    <p>{siteName} is a free utility. We provide it as-is, with no warranty of any kind. We try to keep it accurate and available, but we can't guarantee it.</p>

    <h2>What you agree not to do</h2>
    <ul>
      <li>Don't use the site to harm anyone or break any law.</li>
      <li>Don't try to break the site (DDoS, scraping at scale, exploit hunting) without permission.</li>
      <li>Don't republish our content as if it's yours.</li>
      {customClause && <li>{customClause}</li>}
    </ul>

    <h2>Intellectual property</h2>
    <p>The site's design, code, and original content are ours. Underlying data sources (word lists, area codes, etc.) may have their own licenses; we use public-domain or open-source sources where possible.</p>

    <h2>Limitation of liability</h2>
    <p>{siteName} is provided "as is" without warranty. We are not liable for any damages arising from your use of the site. If you rely on a calculation or output, verify it independently.</p>

    <h2>Changes</h2>
    <p>We may update these terms. Material changes will be noted on the home page.</p>

    <h2>Governing law</h2>
    <p>These terms are governed by the laws of the operator's jurisdiction. Disputes will be resolved in the operator's local courts.</p>

    <h2>Contact</h2>
    <p>Questions? Email us at <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
  </div>
</article>
