---
/**
 * Sidebar of related calculators. The compounder — every calculator
 * cross-links to its siblings, distributing page authority across the
 * domain and increasing pages-per-session.
 */
import type { Calculator } from '../data/calculators';

export interface Props {
  current: string;
  related: Calculator[];
}

const { current, related } = Astro.props;
---
<aside class="card">
  <h3 class="text-sm font-semibold">Related calculators</h3>
  <ul class="mt-3 space-y-2 text-sm">
    {related.map((c) => (
      <li>
        <a
          href={`/calc/${c.slug}`}
          class="flex items-center gap-2 text-neutral-700 hover:text-primary-600 dark:text-neutral-300 dark:hover:text-primary-400"
        >
          <span>{c.icon}</span>
          <span class={c.slug === current ? 'font-semibold' : ''}>{c.title}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
