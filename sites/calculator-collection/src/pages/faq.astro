---
import Layout from '@boring-sites/design/Layout.astro';
import Disclaimer from '../components/Disclaimer.astro';
const siteName = 'Calculator Collection';
const faqs = [
  { q: 'Are these calculators accurate?', a: 'They use standard, well-known formulas (Mifflin-St Jeor for TDEE, US Navy for body fat, etc.) and the math is open on GitHub. That said, no calculator is right for everyone. Use them as estimates, not as the final word on financial, medical, or legal decisions.' },
  { q: 'Do you save my inputs?', a: 'No. All calculations run in your browser. Your inputs live in the URL (so you can share a result) and optionally in your browser\'s localStorage (so the form remembers your last values). Nothing is sent to a server.' },
  { q: 'Why no save / account / history?', a: 'Because we don\'t need to log in to do the math, and you shouldn\'t need to log in to use a calculator. The URL is your "save" — bookmark it or share it.' },
  { q: 'How do you make money?', a: 'Google AdSense. We don\'t sell your data (we don\'t have any), we don\'t run sponsored content, we don\'t have a premium tier.' },
  { q: 'Can I add a calculator to this site?', a: 'Not via UI, but the code is open. Submit a PR on GitHub with the new compute function and the registry entry. See the README for the contribution flow.' },
  { q: 'Are these the same as calculator.net?', a: 'No. calculator.net has 100+ calculators; we have 20. We picked 20 that are most searched and most useful. We will add more over time, prioritizing the highest-volume queries.' },
  { q: 'Do you ship charts?', a: 'Not yet. V1 will add charts for amortization, compound interest, and retirement projections. The dep is already in package.json.' },
];
---
<Layout
  title="FAQ"
  description="Frequently asked questions about the Calculator Collection."
  siteName={siteName}
  jsonLd={{
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  }}
>
  <Disclaimer />
  <article class="container-prose py-12">
    <h1 class="text-4xl font-bold">FAQ</h1>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">Common questions about the Calculator Collection.</p>
    <div class="mt-10 space-y-4">
      {faqs.map((f) => (
        <details class="group rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
          <summary class="cursor-pointer text-lg font-semibold flex items-center justify-between">
            {f.q}
            <span class="text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-neutral-700 dark:text-neutral-300">{f.a}</p>
        </details>
      ))}
    </div>
  </article>
</Layout>
