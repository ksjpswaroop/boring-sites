---
/**
 * The word unscrambler. Renders the input box, runs the unscramble engine
 * client-side as the user types, displays results in a sortable, filterable list.
 */
import words from '../data/words.json';
import { buildIndex } from '../lib/generator';

const wordList: string[] = words as string[];
const index = buildIndex(wordList);
---
<div class="card">
  <label for="letters-input" class="block text-sm font-medium">Letters to unscramble (up to 15)</label>
  <div class="relative mt-2">
    <input
      type="text"
      id="letters-input"
      autocomplete="off"
      autocapitalize="characters"
      spellcheck="false"
      maxlength="15"
      placeholder="e.g. aetprs"
      class="block w-full rounded-lg border border-neutral-300 bg-white px-4 py-4 text-2xl font-mono tracking-widest uppercase dark:border-neutral-700 dark:bg-neutral-900"
    />
  </div>
  <p class="mt-2 text-sm text-neutral-500">
    <span id="result-count">Type letters to see results</span>
  </p>

  <div id="filters" class="mt-4 flex flex-wrap items-center gap-3 text-sm">
    <label class="flex items-center gap-2">
      <span class="text-neutral-500">Min length:</span>
      <input type="number" id="min-length" min="2" max="15" value="2" class="w-16 rounded border border-neutral-300 bg-white px-2 py-1 dark:border-neutral-700 dark:bg-neutral-900" />
    </label>
    <label class="flex items-center gap-2">
      <span class="text-neutral-500">Must contain:</span>
      <input type="text" id="must-contain" maxlength="15" placeholder="(optional)" class="w-24 rounded border border-neutral-300 bg-white px-2 py-1 font-mono uppercase dark:border-neutral-700 dark:bg-neutral-900" />
    </label>
    <label class="flex items-center gap-2">
      <span class="text-neutral-500">Sort:</span>
      <select id="sort-mode" class="rounded border border-neutral-300 bg-white px-2 py-1 dark:border-neutral-700 dark:bg-neutral-900">
        <option value="alpha">A → Z</option>
        <option value="length">Length ↓</option>
        <option value="score" selected>Score ↓</option>
      </select>
    </label>
  </div>
</div>

<div class="mt-8">
  <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Results</h2>
  <ul id="results" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3"></ul>
  <p id="empty-state" class="mt-8 hidden text-center text-sm text-neutral-500">No words found. Try different letters.</p>
</div>

<script is:inline type="application/json" id="word-index-data" set:html={JSON.stringify(Array.from(index.entries()))}></script>

<script>
  import { solve, scrabbleScore, normalizeLetters } from '../lib/generator';

  const indexData = document.getElementById('word-index-data');
  const index = new Map<string, string[]>(JSON.parse(indexData?.textContent || '[]'));

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const input = $<HTMLInputElement>('#letters-input');
  const minLenEl = $<HTMLInputElement>('#min-length');
  const mustContainEl = $<HTMLInputElement>('#must-contain');
  const sortModeEl = $<HTMLSelectElement>('#sort-mode');
  const resultsEl = $<HTMLUListElement>('#results');
  const resultCountEl = $<HTMLElement>('#result-count');
  const emptyEl = $<HTMLElement>('#empty-state');

  if (input && minLenEl && mustContainEl && sortModeEl && resultsEl && resultCountEl && emptyEl) {
    const lettersInput = input;
    const minLengthInput = minLenEl;
    const mustContainInput = mustContainEl;
    const sortSelect = sortModeEl;
    const resultsList = resultsEl;
    const resultCount = resultCountEl;
    const emptyState = emptyEl;

    function render() {
      const raw = lettersInput.value;
      const normalized = normalizeLetters(raw);
      const minLen = parseInt(minLengthInput.value, 10) || 2;
      const mustContain = normalizeLetters(mustContainInput.value || '');
      const sortMode = sortSelect.value;

      if (lettersInput.value !== normalized) lettersInput.value = normalized;
      if (mustContainInput.value !== mustContain) mustContainInput.value = mustContain;

      if (normalized.length < 2) {
        resultsList.innerHTML = '';
        emptyState.classList.add('hidden');
        resultCount.textContent = 'Type at least 2 letters';
        return;
      }

      let results = solve(normalized, index).filter((word) => word.length >= minLen);
      if (mustContain) {
        const requiredLetters = mustContain.split('');
        results = results.filter((word) => requiredLetters.every((letter) => word.includes(letter)));
      }

      if (sortMode === 'alpha') results.sort();
      else if (sortMode === 'length') results.sort((a, b) => b.length - a.length || a.localeCompare(b));
      else if (sortMode === 'score') results.sort((a, b) => scrabbleScore(b) - scrabbleScore(a) || b.length - a.length || a.localeCompare(b));

      resultCount.textContent = results.length === 0
        ? 'No words found'
        : `${results.length} word${results.length === 1 ? '' : 's'} found`;

      if (results.length === 0) {
        resultsList.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }
      emptyState.classList.add('hidden');

      resultsList.innerHTML = results.map((word) => {
        const score = scrabbleScore(word);
        return `
          <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-4 py-2.5 dark:border-neutral-800 dark:bg-neutral-900">
            <div>
              <span class="font-mono font-medium">${word}</span>
              <span class="ml-2 text-xs text-neutral-500">${word.length}L · ${score}pt</span>
            </div>
            <button class="copy-btn text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100" data-word="${word}" aria-label="Copy ${word}">Copy</button>
          </li>`;
      }).join('');

      document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const word = btn.getAttribute('data-word');
          if (!word) return;
          try {
            await navigator.clipboard.writeText(word);
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = original; }, 1200);
          } catch {}
        });
      });
    }

    lettersInput.addEventListener('input', render);
    minLengthInput.addEventListener('input', render);
    mustContainInput.addEventListener('input', render);
    sortSelect.addEventListener('change', render);
    lettersInput.focus();

    const last = localStorage.getItem('boring-sites:wordunscrambler:letters');
    if (last) lettersInput.value = last;
    lettersInput.addEventListener('input', () => localStorage.setItem('boring-sites:wordunscrambler:letters', lettersInput.value));
    render();
  }
</script>
