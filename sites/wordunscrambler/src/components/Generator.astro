---
import WordDetailPanel from './WordDetailPanel.astro';

export interface Props {
  mode?: 'unscrambler' | 'finder' | 'compact';
  heading?: string;
  supportingText?: string;
}

const {
  mode = 'unscrambler',
  heading,
  supportingText,
} = Astro.props;

const isCompact = mode === 'compact';
const inputLabel = mode === 'finder' ? 'Letters you have (up to 15)' : 'Letters to unscramble (up to 15)';
const placeholder = mode === 'finder' ? 'A E T P R S' : 'AETPRS';
---
<div class="lexjolt-card">
  {heading && <h2 class="text-xl font-bold">{heading}</h2>}
  {supportingText && <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{supportingText}</p>}
  <label for="letters-input" class="mt-4 block text-sm font-semibold">{inputLabel}</label>
  <div class="relative mt-2">
    <input
      type="text"
      id="letters-input"
      autocomplete="off"
      autocapitalize="characters"
      spellcheck="false"
      maxlength="15"
      placeholder={placeholder}
      class="lexjolt-input mono block w-full px-4 py-4 text-2xl uppercase"
    />
  </div>
  <p class="mt-2 text-sm text-neutral-500">
    <span id="result-count">Type letters to see results</span>
  </p>

  <div id="filters" class:list={['mt-4 flex flex-wrap items-center gap-3 text-sm', { hidden: isCompact }]}>
    <label class="flex items-center gap-2">
      <span class="text-neutral-500">Min length:</span>
      <input type="number" id="min-length" min="2" max="15" value="2" class="lexjolt-input w-16 px-2 py-1" />
    </label>
    <label class="flex items-center gap-2">
      <span class="text-neutral-500">Sort:</span>
      <select id="sort-mode" class="lexjolt-select px-2 py-1">
        <option value="alpha">A to Z</option>
        <option value="length">Length desc</option>
        <option value="score" selected>Score desc</option>
      </select>
    </label>
    <button id="more-filters-toggle" type="button" class="lexjolt-button lexjolt-button-secondary">More filters</button>
  </div>
  <div id="advanced-filters" class:list={['mt-4 hidden grid-cols-1 gap-3 rounded-lg border border-neutral-200 bg-white p-4 text-sm dark:border-neutral-800 dark:bg-neutral-900 sm:grid-cols-3', { '!hidden': isCompact }]}>
    <label>
      <span class="block text-neutral-500">Max length</span>
      <input type="number" id="max-length" min="2" max="15" value="15" class="lexjolt-input mt-1 w-full px-2 py-1" />
    </label>
    <label>
      <span class="block text-neutral-500">Must contain</span>
      <input type="text" id="must-contain" maxlength="15" placeholder="Optional" class="lexjolt-input mono mt-1 w-full px-2 py-1 uppercase" />
    </label>
    <label class="flex items-center gap-2 pt-6">
      <input type="checkbox" id="exact-anagram" class="h-5 w-5 accent-[#0A66C2]" />
      <span class="text-neutral-600 dark:text-neutral-300">Use all letters</span>
    </label>
  </div>
</div>

<div class="mt-8">
  <div class="flex items-center justify-between gap-3">
    <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Results</h2>
    <button
      id="pronunciation-toggle"
      type="button"
      class="lexjolt-button lexjolt-button-secondary text-sm"
      aria-label="Toggle pronunciation audio"
      title="Toggle pronunciation audio"
    >
      Sound on
    </button>
  </div>
  <ul id="results" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3"></ul>
  <p id="empty-state" class="mt-8 hidden text-center text-sm text-neutral-500">No words found. Try different letters.</p>
  {isCompact && <p class="mt-4"><a id="see-all-results" class="font-semibold text-primary-700 hover:underline dark:text-primary-200" href="/word-finder">See all results</a></p>}
</div>

<WordDetailPanel />

<script>
  import { filterResults, loadIndex, solve, scrabbleScore, normalizeLetters } from '../lib/generator';
  import { getWordInfo, type WordInfo } from '../lib/definitions';
  import { initVoices, isMuted, speak, stopSpeaking, toggleMute } from '../lib/speech';

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const input = $<HTMLInputElement>('#letters-input');
  const minLenEl = $<HTMLInputElement>('#min-length');
  const maxLenEl = $<HTMLInputElement>('#max-length');
  const mustContainEl = $<HTMLInputElement>('#must-contain');
  const exactEl = $<HTMLInputElement>('#exact-anagram');
  const sortModeEl = $<HTMLSelectElement>('#sort-mode');
  const moreFiltersToggle = $<HTMLButtonElement>('#more-filters-toggle');
  const advancedFilters = $<HTMLElement>('#advanced-filters');
  const resultsEl = $<HTMLUListElement>('#results');
  const resultCountEl = $<HTMLElement>('#result-count');
  const emptyEl = $<HTMLElement>('#empty-state');
  const detailPanel = $<HTMLElement>('#word-detail-panel');
  const detailTitle = $<HTMLElement>('#word-detail-title');
  const detailPhonetic = $<HTMLElement>('#word-detail-phonetic');
  const detailContent = $<HTMLElement>('#word-detail-content');
  const detailClose = $<HTMLButtonElement>('#word-detail-close');
  const detailListen = $<HTMLButtonElement>('#word-detail-listen');
  const detailCopy = $<HTMLButtonElement>('#word-detail-copy');
  const detailStatus = $<HTMLElement>('#word-detail-status');
  const pronunciationToggle = $<HTMLButtonElement>('#pronunciation-toggle');
  const seeAllResults = $<HTMLAnchorElement>('#see-all-results');

  if (input && minLenEl && maxLenEl && mustContainEl && exactEl && sortModeEl && resultsEl && resultCountEl && emptyEl && detailPanel && detailTitle && detailPhonetic && detailContent && detailClose && detailListen && detailCopy && detailStatus && pronunciationToggle) {
    const lettersInput = input;
    const minLengthInput = minLenEl;
    const maxLengthInput = maxLenEl;
    const mustContainInput = mustContainEl;
    const exactInput = exactEl;
    const sortSelect = sortModeEl;
    const resultsList = resultsEl;
    const resultCount = resultCountEl;
    const emptyState = emptyEl;
    const soundToggle = pronunciationToggle;
    let activeAbort: AbortController | null = null;
    let activeWord = '';
    let index = new Map<string, string[]>();
    let indexReady = false;

    initVoices();
    lettersInput.disabled = true;
    minLengthInput.disabled = true;
    maxLengthInput.disabled = true;
    mustContainInput.disabled = true;
    exactInput.disabled = true;
    sortSelect.disabled = true;
    resultCount.textContent = 'Loading dictionary...';

    const escapeHtml = (value: string) => value
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const renderInfo = (info: WordInfo | null) => {
      if (!info) {
        detailContent.innerHTML = '<p>No local definition is included for this word. The solver still works offline.</p>';
        detailPhonetic.textContent = 'Pronunciation unavailable';
        return;
      }

      const meaningHtml = info.meanings.map((meaning) => `
        <section class="border-t border-neutral-200 pt-3 first:border-t-0 first:pt-0 dark:border-neutral-800">
          <div class="text-xs font-bold uppercase text-primary-700 dark:text-primary-200">${escapeHtml(meaning.partOfSpeech)}</div>
          ${meaning.definitions.map((definition) => `
            <p class="mt-2 leading-6">${escapeHtml(definition.definition)}</p>
            ${definition.example ? `<p class="mt-1 text-neutral-500">Example: ${escapeHtml(definition.example)}</p>` : ''}
          `).join('')}
        </section>
      `).join('');

      detailPhonetic.textContent = info.phonetic || 'Pronunciation unavailable';
      detailContent.innerHTML = `<div class="space-y-4">${meaningHtml}</div>`;
    };

    const openDetail = async (word: string) => {
      activeWord = word;
      activeAbort?.abort();
      activeAbort = new AbortController();
      detailTitle.textContent = word;
      detailPhonetic.textContent = 'Looking up pronunciation...';
      detailContent.innerHTML = '<p>Looking up meaning and usage...</p>';
      detailStatus.textContent = '';
      detailPanel.classList.add('is-open');
      detailPanel.setAttribute('aria-hidden', 'false');
      const info = await getWordInfo(word, activeAbort.signal);
      if (activeWord !== word) return;
      renderInfo(info);
    };

    const closeDetail = () => {
      activeAbort?.abort();
      activeWord = '';
      detailPanel.classList.remove('is-open');
      detailPanel.setAttribute('aria-hidden', 'true');
      stopSpeaking();
    };

    detailClose.addEventListener('click', closeDetail);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeDetail();
    });
    detailListen.addEventListener('click', () => {
      if (!activeWord) return;
      detailStatus.textContent = 'Playing pronunciation.';
      speak(activeWord, () => { detailStatus.textContent = ''; });
    });
    detailCopy.addEventListener('click', async () => {
      if (!activeWord) return;
      try {
        await navigator.clipboard.writeText(activeWord);
        detailStatus.textContent = 'Word copied.';
      } catch {
        detailStatus.textContent = activeWord;
      }
    });

    soundToggle.addEventListener('click', () => {
      const muted = toggleMute();
      soundToggle.textContent = muted ? 'Sound off' : 'Sound on';
      soundToggle.classList.toggle('text-neutral-400', muted);
      soundToggle.setAttribute('aria-pressed', String(!muted));
    });
    soundToggle.setAttribute('aria-pressed', String(!isMuted()));

    function render() {
      if (!indexReady) {
        resultsList.innerHTML = '';
        emptyState.classList.add('hidden');
        return;
      }

      const raw = lettersInput.value;
      const normalized = normalizeLetters(raw);
      const minLen = parseInt(minLengthInput.value, 10) || 2;
      const maxLen = parseInt(maxLengthInput.value, 10) || 15;
      const mustContain = normalizeLetters(mustContainInput.value || '');
      const sortMode = sortSelect.value;

      if (lettersInput.value !== normalized) lettersInput.value = normalized;
      if (mustContainInput.value !== mustContain) mustContainInput.value = mustContain;

      if (normalized.length < 2) {
        resultsList.innerHTML = '';
        emptyState.classList.add('hidden');
        resultCount.textContent = 'Type at least 2 letters';
        return;
      }

      const results = filterResults(solve(normalized, index), {
        minLength: minLen,
        maxLength: maxLen,
        mustContain,
        exact: exactInput.checked,
        letters: normalized,
        sort: sortMode === 'alpha' || sortMode === 'length' ? sortMode : 'score',
      });
      if (seeAllResults) seeAllResults.href = `/word-finder?letters=${encodeURIComponent(normalized)}`;

      resultCount.textContent = results.length === 0
        ? 'No words found'
        : `${results.length} word${results.length === 1 ? '' : 's'} found`;

      if (results.length === 0) {
        resultsList.innerHTML = '';
        emptyState.classList.remove('hidden');
        return;
      }
      emptyState.classList.add('hidden');

      resultsList.innerHTML = results.map((word) => {
        const score = scrabbleScore(word);
        return `
          <li class="word-result flex items-center justify-between rounded-md border border-neutral-200 bg-white px-4 py-2.5 transition hover:border-primary-300 hover:bg-primary-50 focus-within:border-primary-400 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-primary-700 dark:hover:bg-primary-950/40" data-word="${word}">
            <button type="button" class="word-result-button min-h-11 flex-1" data-open-word="${word}" aria-label="Open details for ${word}">
              <span class="font-mono font-medium">${word}</span>
              <span class="ml-2 text-xs text-neutral-500">${word.length} letters · ${score} pts</span>
            </button>
            <button class="copy-btn text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100" data-word="${word}" aria-label="Copy ${word}">Copy</button>
          </li>`;
      }).join('');

      document.querySelectorAll<HTMLButtonElement>('[data-open-word]').forEach((item) => {
        const word = item.dataset.openWord;
        if (!word) return;
        item.addEventListener('click', () => openDetail(word));
      });

      document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const word = btn.getAttribute('data-word');
          if (!word) return;
          try {
            await navigator.clipboard.writeText(word);
            const original = btn.textContent;
            btn.textContent = 'Copied!';
            setTimeout(() => { btn.textContent = original; }, 1200);
          } catch {}
        });
      });
    }

    lettersInput.addEventListener('input', render);
    minLengthInput.addEventListener('input', render);
    maxLengthInput.addEventListener('input', render);
    mustContainInput.addEventListener('input', render);
    exactInput.addEventListener('change', render);
    sortSelect.addEventListener('change', render);
    moreFiltersToggle?.addEventListener('click', () => {
      const isHidden = advancedFilters?.classList.toggle('hidden');
      moreFiltersToggle.textContent = isHidden ? 'More filters' : 'Hide filters';
      moreFiltersToggle.setAttribute('aria-expanded', String(!isHidden));
    });

    const oldLast = localStorage.getItem('boring-sites:wordunscrambler:letters');
    if (oldLast && !localStorage.getItem('lexjolt:unscrambler:last-input')) {
      localStorage.setItem('lexjolt:unscrambler:last-input', oldLast);
      localStorage.removeItem('boring-sites:wordunscrambler:letters');
    }
    const last = localStorage.getItem('lexjolt:unscrambler:last-input');
    if (last) lettersInput.value = last;
    lettersInput.addEventListener('input', () => localStorage.setItem('lexjolt:unscrambler:last-input', lettersInput.value));

    loadIndex()
      .then((loadedIndex) => {
        index = loadedIndex;
        indexReady = true;
        lettersInput.disabled = false;
        minLengthInput.disabled = false;
        maxLengthInput.disabled = false;
        mustContainInput.disabled = false;
        exactInput.disabled = false;
        sortSelect.disabled = false;
        lettersInput.focus();
        render();
      })
      .catch(() => {
        resultCount.textContent = 'Dictionary failed to load';
        emptyState.textContent = 'Refresh the page to try loading the dictionary again.';
        emptyState.classList.remove('hidden');
      });
  }
</script>
