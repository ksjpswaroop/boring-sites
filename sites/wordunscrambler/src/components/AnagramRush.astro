---
/**
 * Timed word-finding game using the existing anagram solver.
 */
import racks from '../data/rush-racks.json';
---

<section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
  <div class="lexjolt-card">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="lexjolt-eyebrow">90-second word sprint</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight">Anagram Rush</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Make as many words as you can in 90 seconds.</p>
      </div>
      <div class="grid grid-cols-3 gap-2 text-center text-sm">
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-time" class="font-mono text-xl font-bold">90</div>
          <div class="text-xs text-neutral-500">seconds</div>
        </div>
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-score" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">score</div>
        </div>
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-found-count" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">found</div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <p class="text-sm text-neutral-500">Make as many words as you can from these letters.</p>
      <div id="rush-letters" class="mt-3 flex flex-wrap gap-2" aria-label="Current letters"></div>
    </div>

    <form id="rush-form" class="mt-6 flex flex-col gap-3 sm:flex-row">
      <label for="rush-input" class="sr-only">Enter a word</label>
      <input
        id="rush-input"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="15"
        placeholder="Type a word"
        class="min-w-0 flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-3 font-mono text-lg uppercase tracking-widest dark:border-neutral-700 dark:bg-neutral-900"
      />
      <button id="rush-submit" type="submit" class="btn btn-primary px-5 py-3">Submit</button>
    </form>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button id="rush-start" type="button" class="lexjolt-button lexjolt-button-primary">Start Rush</button>
      <button id="rush-end" type="button" class="lexjolt-button lexjolt-button-secondary" disabled>End round</button>
      <button id="rush-reveal" type="button" class="lexjolt-button lexjolt-button-secondary" disabled>Review missed words</button>
      <p id="rush-message" class="text-sm text-neutral-500" aria-live="polite">Start a round to begin.</p>
    </div>

    <div id="rush-final" class="mt-6 hidden rounded-lg border border-sky-200 bg-sky-50 p-4 text-sm dark:border-sky-900 dark:bg-sky-950/40"></div>
  </div>

  <aside class="space-y-6">
    <div class="lexjolt-card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Local stats</h2>
      <dl class="mt-3 grid gap-3 text-sm">
        <div class="flex items-center justify-between"><dt class="text-neutral-500">Best score</dt><dd id="rush-best-score" class="mono font-semibold">0</dd></div>
        <div class="flex items-center justify-between"><dt class="text-neutral-500">Best words</dt><dd id="rush-best-count" class="mono font-semibold">0</dd></div>
        <div class="flex items-center justify-between"><dt class="text-neutral-500">Rounds played</dt><dd id="rush-rounds" class="mono font-semibold">0</dd></div>
      </dl>
    </div>
    <div class="lexjolt-card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Found words</h2>
      <ul id="rush-found" class="mt-3 grid gap-2"></ul>
      <p id="rush-empty" class="mt-4 text-sm text-neutral-500">No words yet.</p>
    </div>
    <div class="lexjolt-card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Missed words</h2>
      <ul id="rush-missed" class="mt-3 grid gap-2"></ul>
      <p id="rush-missed-empty" class="mt-4 text-sm text-neutral-500">Reveal after the round.</p>
    </div>
  </aside>
</section>

<script is:inline type="application/json" id="rush-racks-data" set:html={JSON.stringify(racks)}></script>

<script>
  import { canBuildWord, loadIndex, normalizeLetters, rushScore, solve } from '../lib/generator';

  const racksData = document.getElementById('rush-racks-data');
  const racks = JSON.parse(racksData?.textContent || '[]') as Array<{ letters: string; answer_count: number; max_word_length: number; difficulty: string; possible_score: number }>;

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const lettersEl = $<HTMLElement>('#rush-letters');
  const form = $<HTMLFormElement>('#rush-form');
  const input = $<HTMLInputElement>('#rush-input');
  const startBtn = $<HTMLButtonElement>('#rush-start');
  const endBtn = $<HTMLButtonElement>('#rush-end');
  const revealBtn = $<HTMLButtonElement>('#rush-reveal');
  const submitBtn = $<HTMLButtonElement>('#rush-submit');
  const timeEl = $<HTMLElement>('#rush-time');
  const scoreEl = $<HTMLElement>('#rush-score');
  const foundCountEl = $<HTMLElement>('#rush-found-count');
  const foundEl = $<HTMLUListElement>('#rush-found');
  const missedEl = $<HTMLUListElement>('#rush-missed');
  const emptyEl = $<HTMLElement>('#rush-empty');
  const missedEmptyEl = $<HTMLElement>('#rush-missed-empty');
  const messageEl = $<HTMLElement>('#rush-message');
  const finalEl = $<HTMLElement>('#rush-final');
  const bestScoreEl = $<HTMLElement>('#rush-best-score');
  const bestCountEl = $<HTMLElement>('#rush-best-count');
  const roundsEl = $<HTMLElement>('#rush-rounds');

  if (lettersEl && form && input && startBtn && endBtn && revealBtn && submitBtn && timeEl && scoreEl && foundCountEl && foundEl && missedEl && emptyEl && missedEmptyEl && messageEl && finalEl && bestScoreEl && bestCountEl && roundsEl) {
    const roundSeconds = 90;
    const statsKey = 'lexjolt:rush:stats';
    const oldStatsKey = 'boring-sites:wordunscrambler:rush-stats';
    let rack = '';
    let answers: string[] = [];
    let found = new Set<string>();
    let score = 0;
    let endAt = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let active = false;
    let index = new Map<string, string[]>();
    let indexReady = false;

    input.disabled = true;
    submitBtn.disabled = true;
    startBtn.disabled = true;
    revealBtn.disabled = true;
    messageEl.textContent = 'Loading dictionary...';

    type RushStats = { best_score: number; best_word_count: number; rounds_played: number; average_score: number; last_played: string; replay_count: number };
    const defaultStats: RushStats = { best_score: 0, best_word_count: 0, rounds_played: 0, average_score: 0, last_played: '', replay_count: 0 };

    const migrateStats = () => {
      const oldStats = localStorage.getItem(oldStatsKey);
      if (oldStats && !localStorage.getItem(statsKey)) {
        localStorage.setItem(statsKey, oldStats);
        localStorage.removeItem(oldStatsKey);
      }
    };

    const readStats = (): RushStats => {
      migrateStats();
      try {
        return { ...defaultStats, ...JSON.parse(localStorage.getItem(statsKey) || '{}') };
      } catch {
        return defaultStats;
      }
    };

    const writeStats = (next: RushStats) => {
      localStorage.setItem(statsKey, JSON.stringify(next));
      renderStats();
    };

    const renderStats = () => {
      const stats = readStats();
      bestScoreEl.textContent = String(stats.best_score);
      bestCountEl.textContent = String(stats.best_word_count);
      roundsEl.textContent = String(stats.rounds_played);
    };

    const pointsFor = (word: string) => rushScore(word);

    const setMessage = (text: string) => {
      messageEl.textContent = text;
    };

    const renderLetters = () => {
      lettersEl.innerHTML = rack.split('').map((letter) => `
        <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-600 font-mono text-xl font-bold text-white shadow-sm">${letter}</span>
      `).join('');
    };

    const renderFound = () => {
      foundCountEl.textContent = String(found.size);
      scoreEl.textContent = String(score);
      const words = Array.from(found).sort((a, b) => b.length - a.length || a.localeCompare(b));
      foundEl.innerHTML = words.map((word) => `
        <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="font-mono font-medium">${word}</span>
          <span class="text-xs text-neutral-500">${pointsFor(word)} pt</span>
        </li>
      `).join('');
      emptyEl.classList.toggle('hidden', words.length > 0);
    };

    const renderMissed = () => {
      if (active) {
        setMessage('Missed words are available after the round.');
        return;
      }
      const missed = answers.filter((word) => !found.has(word));
      missedEl.innerHTML = missed.slice(0, 24).map((word) => `
        <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="font-mono font-medium">${word}</span>
          <span class="text-xs text-neutral-500">${word.length}L</span>
        </li>
      `).join('');
      missedEmptyEl.textContent = missed.length === 0 ? 'Nothing missed.' : `${missed.length} missed. Showing top ${Math.min(24, missed.length)}.`;
      missedEmptyEl.classList.remove('hidden');
    };

    const finishRound = () => {
      if (!active && finalEl.classList.contains('hidden') === false) return;
      active = false;
      if (timer) clearInterval(timer);
      timer = null;
      input.disabled = true;
      submitBtn.disabled = true;
      endBtn.disabled = true;
      revealBtn.disabled = false;
      startBtn.textContent = 'Play Again';
      finalEl.classList.remove('hidden');
      const bestWord = Array.from(found).sort((a, b) => b.length - a.length || pointsFor(b) - pointsFor(a))[0] || '-';
      finalEl.innerHTML = `
        <h3 class="text-lg font-bold">Great rush!</h3>
        <dl class="mt-3 grid gap-2 sm:grid-cols-2">
          <div><dt class="text-neutral-500">Score</dt><dd class="mono text-xl font-bold">${score}</dd></div>
          <div><dt class="text-neutral-500">Words found</dt><dd class="mono text-xl font-bold">${found.size}</dd></div>
          <div><dt class="text-neutral-500">Possible words</dt><dd class="mono text-xl font-bold">${answers.length}</dd></div>
          <div><dt class="text-neutral-500">Best word</dt><dd class="mono text-xl font-bold">${bestWord}</dd></div>
        </dl>
      `;
      const stats = readStats();
      const roundsPlayed = stats.rounds_played + 1;
      writeStats({
        best_score: Math.max(stats.best_score, score),
        best_word_count: Math.max(stats.best_word_count, found.size),
        rounds_played: roundsPlayed,
        average_score: Math.round(((stats.average_score * stats.rounds_played) + score) / roundsPlayed),
        last_played: new Date().toISOString(),
        replay_count: stats.rounds_played > 0 ? stats.replay_count + 1 : stats.replay_count,
      });
      setMessage('Round complete. Reveal missed words or start again.');
    };

    const startRound = () => {
      if (!indexReady) {
        setMessage('Dictionary is still loading.');
        return;
      }

      const selected = racks[Math.floor(Math.random() * racks.length)];
      rack = selected?.letters || 'PLANETS';
      answers = solve(rack, index)
        .filter((word) => word.length >= 3 && canBuildWord(word, rack))
        .sort((a, b) => pointsFor(b) - pointsFor(a) || b.length - a.length || a.localeCompare(b));
      found = new Set();
      score = 0;
      endAt = performance.now() + roundSeconds * 1000;
      active = true;
      input.disabled = false;
      submitBtn.disabled = false;
      endBtn.disabled = false;
      revealBtn.disabled = true;
      input.value = '';
      finalEl.classList.add('hidden');
      missedEl.innerHTML = '';
      missedEmptyEl.textContent = 'Reveal after the round.';
      timeEl.textContent = String(roundSeconds);
      renderLetters();
      renderFound();
      setMessage(`${answers.length} possible words. Minimum length is 3.`);
      input.focus();
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        const remaining = Math.max(0, Math.ceil((endAt - performance.now()) / 1000));
        timeEl.textContent = String(remaining);
        if (remaining <= 0) finishRound();
      }, 250);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const word = normalizeLetters(input.value);
      input.value = '';
      if (!active) {
        setMessage('Start a round first.');
        return;
      }
      if (word.length < 3) {
        setMessage('Use at least 3 letters.');
        return;
      }
      if (!canBuildWord(word, rack)) {
        setMessage(`${word} cannot be made from these letters.`);
        return;
      }
      if (!answers.includes(word)) {
        setMessage(`${word} is not in this word list.`);
        return;
      }
      if (found.has(word)) {
        setMessage(`${word} was already found.`);
        return;
      }
      found.add(word);
      const gained = pointsFor(word);
      score += gained;
      renderFound();
      setMessage(`+${gained} points for ${word}.`);
      if (found.size === answers.length) finishRound();
    });

    input.addEventListener('input', () => {
      const normalized = normalizeLetters(input.value);
      if (input.value !== normalized) input.value = normalized;
    });
    startBtn.addEventListener('click', startRound);
    endBtn.addEventListener('click', finishRound);
    revealBtn.addEventListener('click', renderMissed);
    renderStats();
    loadIndex()
      .then((loadedIndex) => {
        index = loadedIndex;
        indexReady = true;
        startBtn.disabled = false;
        setMessage('Start a round to begin.');
      })
      .catch(() => {
        setMessage('Dictionary failed to load. Refresh the page to try again.');
      });
  }
</script>
