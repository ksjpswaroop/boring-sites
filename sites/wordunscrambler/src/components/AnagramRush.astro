---
/**
 * Timed word-finding game using the existing anagram solver.
 */
const racks = [
  'PLANETS',
  'TRAINES',
  'PARTIES',
  'ROASTED',
  'STAINER',
  'LOPINGS',
  'CRANEST',
  'DEALING',
  'REACTOS',
  'MONSTER',
  'GARDENS',
  'SILENCE',
  'RESCUEA',
  'TANGLES',
  'ORANGES',
  'RATIONS',
  'CREDITS',
  'HEARING',
  'LEAPING',
  'SENATOR',
];
---

<section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
  <div class="card">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-primary-700 dark:text-primary-300">90-second word sprint</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight">Anagram Rush</h2>
      </div>
      <div class="grid grid-cols-3 gap-2 text-center text-sm">
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-time" class="font-mono text-xl font-bold">90</div>
          <div class="text-xs text-neutral-500">seconds</div>
        </div>
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-score" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">score</div>
        </div>
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="rush-found-count" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">found</div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <p class="text-sm text-neutral-500">Make as many words as you can from these letters.</p>
      <div id="rush-letters" class="mt-3 flex flex-wrap gap-2" aria-label="Current letters"></div>
    </div>

    <form id="rush-form" class="mt-6 flex flex-col gap-3 sm:flex-row">
      <label for="rush-input" class="sr-only">Enter a word</label>
      <input
        id="rush-input"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="15"
        placeholder="Type a word"
        class="min-w-0 flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-3 font-mono text-lg uppercase tracking-widest dark:border-neutral-700 dark:bg-neutral-900"
      />
      <button id="rush-submit" type="submit" class="btn btn-primary px-5 py-3">Submit</button>
    </form>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button id="rush-start" type="button" class="btn btn-secondary">Start new round</button>
      <button id="rush-reveal" type="button" class="btn btn-secondary">Reveal missed words</button>
      <p id="rush-message" class="text-sm text-neutral-500" aria-live="polite">Start a round to begin.</p>
    </div>

    <div id="rush-final" class="mt-6 hidden rounded-lg border border-sky-200 bg-sky-50 p-4 text-sm dark:border-sky-900 dark:bg-sky-950/40"></div>
  </div>

  <aside class="space-y-6">
    <div class="card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Found words</h2>
      <ul id="rush-found" class="mt-3 grid gap-2"></ul>
      <p id="rush-empty" class="mt-4 text-sm text-neutral-500">No words yet.</p>
    </div>
    <div class="card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Missed words</h2>
      <ul id="rush-missed" class="mt-3 grid gap-2"></ul>
      <p id="rush-missed-empty" class="mt-4 text-sm text-neutral-500">Reveal after the round.</p>
    </div>
  </aside>
</section>

<script is:inline type="application/json" id="rush-racks-data" set:html={JSON.stringify(racks)}></script>

<script>
  import { loadIndex, normalizeLetters, scrabbleScore, solve } from '../lib/generator';

  const racksData = document.getElementById('rush-racks-data');
  const racks = JSON.parse(racksData?.textContent || '[]') as string[];

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const lettersEl = $<HTMLElement>('#rush-letters');
  const form = $<HTMLFormElement>('#rush-form');
  const input = $<HTMLInputElement>('#rush-input');
  const startBtn = $<HTMLButtonElement>('#rush-start');
  const revealBtn = $<HTMLButtonElement>('#rush-reveal');
  const submitBtn = $<HTMLButtonElement>('#rush-submit');
  const timeEl = $<HTMLElement>('#rush-time');
  const scoreEl = $<HTMLElement>('#rush-score');
  const foundCountEl = $<HTMLElement>('#rush-found-count');
  const foundEl = $<HTMLUListElement>('#rush-found');
  const missedEl = $<HTMLUListElement>('#rush-missed');
  const emptyEl = $<HTMLElement>('#rush-empty');
  const missedEmptyEl = $<HTMLElement>('#rush-missed-empty');
  const messageEl = $<HTMLElement>('#rush-message');
  const finalEl = $<HTMLElement>('#rush-final');

  if (lettersEl && form && input && startBtn && revealBtn && submitBtn && timeEl && scoreEl && foundCountEl && foundEl && missedEl && emptyEl && missedEmptyEl && messageEl && finalEl) {
    const roundSeconds = 90;
    let rack = '';
    let answers: string[] = [];
    let found = new Set<string>();
    let score = 0;
    let timeLeft = roundSeconds;
    let timer: ReturnType<typeof setInterval> | null = null;
    let active = false;
    let index = new Map<string, string[]>();
    let indexReady = false;

    input.disabled = true;
    submitBtn.disabled = true;
    startBtn.disabled = true;
    revealBtn.disabled = true;
    messageEl.textContent = 'Loading dictionary...';

    const canBuild = (word: string, letters: string) => {
      const counts: Record<string, number> = {};
      for (const letter of letters) counts[letter] = (counts[letter] || 0) + 1;
      for (const letter of word) {
        counts[letter] = (counts[letter] || 0) - 1;
        if (counts[letter] < 0) return false;
      }
      return true;
    };

    const pointsFor = (word: string) => scrabbleScore(word) + Math.max(0, word.length - 3) * 2;

    const setMessage = (text: string) => {
      messageEl.textContent = text;
    };

    const renderLetters = () => {
      lettersEl.innerHTML = rack.split('').map((letter) => `
        <span class="flex h-12 w-12 items-center justify-center rounded-md bg-primary-600 font-mono text-xl font-bold text-white shadow-sm">${letter}</span>
      `).join('');
    };

    const renderFound = () => {
      foundCountEl.textContent = String(found.size);
      scoreEl.textContent = String(score);
      const words = Array.from(found).sort((a, b) => b.length - a.length || a.localeCompare(b));
      foundEl.innerHTML = words.map((word) => `
        <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="font-mono font-medium">${word}</span>
          <span class="text-xs text-neutral-500">${pointsFor(word)} pt</span>
        </li>
      `).join('');
      emptyEl.classList.toggle('hidden', words.length > 0);
    };

    const renderMissed = () => {
      const missed = answers.filter((word) => !found.has(word));
      missedEl.innerHTML = missed.slice(0, 24).map((word) => `
        <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="font-mono font-medium">${word}</span>
          <span class="text-xs text-neutral-500">${word.length}L</span>
        </li>
      `).join('');
      missedEmptyEl.textContent = missed.length === 0 ? 'Nothing missed.' : `${missed.length} missed. Showing top ${Math.min(24, missed.length)}.`;
      missedEmptyEl.classList.remove('hidden');
    };

    const finishRound = () => {
      active = false;
      if (timer) clearInterval(timer);
      timer = null;
      input.disabled = true;
      submitBtn.disabled = true;
      finalEl.classList.remove('hidden');
      finalEl.textContent = `Round complete: ${found.size} of ${answers.length} words found for ${score} points.`;
      setMessage('Round complete. Reveal missed words or start again.');
      renderMissed();
    };

    const startRound = () => {
      if (!indexReady) {
        setMessage('Dictionary is still loading.');
        return;
      }

      rack = racks[Math.floor(Math.random() * racks.length)];
      answers = solve(rack, index)
        .filter((word) => word.length >= 3 && canBuild(word, rack))
        .sort((a, b) => pointsFor(b) - pointsFor(a) || b.length - a.length || a.localeCompare(b));
      found = new Set();
      score = 0;
      timeLeft = roundSeconds;
      active = true;
      input.disabled = false;
      submitBtn.disabled = false;
      input.value = '';
      finalEl.classList.add('hidden');
      missedEl.innerHTML = '';
      missedEmptyEl.textContent = 'Reveal after the round.';
      timeEl.textContent = String(timeLeft);
      renderLetters();
      renderFound();
      setMessage(`${answers.length} possible words. Minimum length is 3.`);
      input.focus();
      if (timer) clearInterval(timer);
      timer = setInterval(() => {
        timeLeft -= 1;
        timeEl.textContent = String(timeLeft);
        if (timeLeft <= 0) finishRound();
      }, 1000);
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const word = normalizeLetters(input.value);
      input.value = '';
      if (!active) {
        setMessage('Start a round first.');
        return;
      }
      if (word.length < 3) {
        setMessage('Use at least 3 letters.');
        return;
      }
      if (!canBuild(word, rack)) {
        setMessage(`${word} cannot be made from these letters.`);
        return;
      }
      if (!answers.includes(word)) {
        setMessage(`${word} is not in this word list.`);
        return;
      }
      if (found.has(word)) {
        setMessage(`${word} was already found.`);
        return;
      }
      found.add(word);
      const gained = pointsFor(word);
      score += gained;
      renderFound();
      setMessage(`+${gained} points for ${word}.`);
      if (found.size === answers.length) finishRound();
    });

    input.addEventListener('input', () => {
      const normalized = normalizeLetters(input.value);
      if (input.value !== normalized) input.value = normalized;
    });
    startBtn.addEventListener('click', startRound);
    revealBtn.addEventListener('click', renderMissed);
    loadIndex()
      .then((loadedIndex) => {
        index = loadedIndex;
        indexReady = true;
        startBtn.disabled = false;
        revealBtn.disabled = false;
        setMessage('Start a round to begin.');
        startRound();
      })
      .catch(() => {
        setMessage('Dictionary failed to load. Refresh the page to try again.');
      });
  }
</script>
