---
/**
 * Deterministic daily word challenge. Static-friendly: date + seed decide the puzzle.
 */
import words from '../data/words.json';
import { buildIndex } from '../lib/generator';

const wordList: string[] = words as string[];
const index = buildIndex(wordList);
const puzzles = [
  { letters: 'PLANETS', required: 'A' },
  { letters: 'TRAINES', required: 'E' },
  { letters: 'ROASTED', required: 'R' },
  { letters: 'STAINER', required: 'T' },
  { letters: 'CRANEST', required: 'E' },
  { letters: 'DEALING', required: 'D' },
  { letters: 'MONSTER', required: 'O' },
  { letters: 'GARDENS', required: 'G' },
  { letters: 'SILENCE', required: 'E' },
  { letters: 'ORANGES', required: 'O' },
  { letters: 'RATIONS', required: 'N' },
  { letters: 'CREDITS', required: 'E' },
  { letters: 'HEARING', required: 'R' },
  { letters: 'LEAPING', required: 'P' },
  { letters: 'SENATOR', required: 'S' },
  { letters: 'RELATES', required: 'L' },
  { letters: 'ACTIONS', required: 'T' },
  { letters: 'PAINTER', required: 'P' },
  { letters: 'READING', required: 'R' },
  { letters: 'COASTED', required: 'S' },
];
---

<section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
  <div class="card">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <p id="daily-date" class="text-sm font-medium text-primary-700 dark:text-primary-300">Daily challenge</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight">Daily Scramble</h2>
        <p class="mt-2 max-w-2xl text-sm text-neutral-600 dark:text-neutral-400">
          Find words with the required center letter. Everyone gets the same puzzle for the day.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2 text-center text-sm">
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="daily-score" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">score</div>
        </div>
        <div class="rounded-md border border-neutral-200 px-3 py-2 dark:border-neutral-800">
          <div id="daily-found-count" class="font-mono text-xl font-bold">0</div>
          <div class="text-xs text-neutral-500">found</div>
        </div>
      </div>
    </div>

    <div class="mt-8">
      <p class="text-sm text-neutral-500">The blue tile is required in every answer.</p>
      <div id="daily-letters" class="mt-3 flex flex-wrap gap-2" aria-label="Daily letters"></div>
    </div>

    <form id="daily-form" class="mt-6 flex flex-col gap-3 sm:flex-row">
      <label for="daily-input" class="sr-only">Enter a word</label>
      <input
        id="daily-input"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="15"
        placeholder="Type a word"
        class="min-w-0 flex-1 rounded-lg border border-neutral-300 bg-white px-4 py-3 font-mono text-lg uppercase tracking-widest dark:border-neutral-700 dark:bg-neutral-900"
      />
      <button id="daily-submit" type="submit" class="btn btn-primary px-5 py-3">Submit</button>
    </form>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button id="daily-hint" type="button" class="btn btn-secondary">Hint</button>
      <button id="daily-share" type="button" class="btn btn-secondary">Copy share result</button>
      <p id="daily-message" class="text-sm text-neutral-500" aria-live="polite">Minimum length is 4.</p>
    </div>

    <div class="mt-6 h-3 overflow-hidden rounded-full bg-neutral-100 dark:bg-neutral-800">
      <div id="daily-progress" class="h-full rounded-full bg-primary-600 transition-all" style="width: 0%"></div>
    </div>
  </div>

  <aside class="space-y-6">
    <div class="card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Today</h2>
      <dl class="mt-3 grid gap-3 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-neutral-500">Possible words</dt>
          <dd id="daily-total" class="font-mono font-semibold">0</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-neutral-500">Best word</dt>
          <dd id="daily-best" class="font-mono font-semibold">-</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-neutral-500">Streak</dt>
          <dd id="daily-streak" class="font-mono font-semibold">0</dd>
        </div>
      </dl>
    </div>

    <div class="card">
      <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Found words</h2>
      <ul id="daily-found" class="mt-3 grid gap-2"></ul>
      <p id="daily-empty" class="mt-4 text-sm text-neutral-500">No words yet.</p>
    </div>
  </aside>
</section>

<script is:inline type="application/json" id="daily-index-data" set:html={JSON.stringify(Array.from(index.entries()))}></script>
<script is:inline type="application/json" id="daily-puzzles-data" set:html={JSON.stringify(puzzles)}></script>

<script>
  import { normalizeLetters, scrabbleScore, solve } from '../lib/generator';

  type Puzzle = { letters: string; required: string };

  const indexData = document.getElementById('daily-index-data');
  const puzzlesData = document.getElementById('daily-puzzles-data');
  const index = new Map<string, string[]>(JSON.parse(indexData?.textContent || '[]'));
  const puzzles = JSON.parse(puzzlesData?.textContent || '[]') as Puzzle[];

  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector);
  const dateEl = $<HTMLElement>('#daily-date');
  const lettersEl = $<HTMLElement>('#daily-letters');
  const form = $<HTMLFormElement>('#daily-form');
  const input = $<HTMLInputElement>('#daily-input');
  const scoreEl = $<HTMLElement>('#daily-score');
  const foundCountEl = $<HTMLElement>('#daily-found-count');
  const totalEl = $<HTMLElement>('#daily-total');
  const bestEl = $<HTMLElement>('#daily-best');
  const streakEl = $<HTMLElement>('#daily-streak');
  const foundEl = $<HTMLUListElement>('#daily-found');
  const emptyEl = $<HTMLElement>('#daily-empty');
  const messageEl = $<HTMLElement>('#daily-message');
  const progressEl = $<HTMLElement>('#daily-progress');
  const hintBtn = $<HTMLButtonElement>('#daily-hint');
  const shareBtn = $<HTMLButtonElement>('#daily-share');

  if (dateEl && lettersEl && form && input && scoreEl && foundCountEl && totalEl && bestEl && streakEl && foundEl && emptyEl && messageEl && progressEl && hintBtn && shareBtn) {
    const today = new Date();
    const dayKey = today.toISOString().slice(0, 10);
    const dayNumber = Math.floor(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) / 86400000);
    const puzzle = puzzles[dayNumber % puzzles.length];
    const storageKey = `boring-sites:wordunscrambler:daily:${dayKey}`;
    const streakKey = 'boring-sites:wordunscrambler:daily-streak';
    const found = new Set<string>(JSON.parse(localStorage.getItem(storageKey) || '[]'));

    const canBuild = (word: string, letters: string) => {
      const counts: Record<string, number> = {};
      for (const letter of letters) counts[letter] = (counts[letter] || 0) + 1;
      for (const letter of word) {
        counts[letter] = (counts[letter] || 0) - 1;
        if (counts[letter] < 0) return false;
      }
      return true;
    };

    const pointsFor = (word: string) => word.length === 4 ? 1 : word.length + scrabbleScore(word);
    const isPangram = (word: string) => new Set(puzzle.letters.split('')).size === new Set(word.split('')).size;
    const answers = solve(puzzle.letters, index)
      .filter((word) => word.length >= 4 && word.includes(puzzle.required) && canBuild(word, puzzle.letters))
      .sort((a, b) => pointsFor(b) - pointsFor(a) || b.length - a.length || a.localeCompare(b));
    const best = answers[0] || '-';

    const readStreak = () => {
      try {
        return JSON.parse(localStorage.getItem(streakKey) || '{"lastDay":"","count":0}') as { lastDay: string; count: number };
      } catch {
        return { lastDay: '', count: 0 };
      }
    };

    const updateStreak = () => {
      const current = readStreak();
      if (found.size === 0) {
        streakEl.textContent = String(current.count || 0);
        return;
      }
      if (current.lastDay === dayKey) {
        streakEl.textContent = String(current.count || 1);
        return;
      }
      const yesterday = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) - 86400000).toISOString().slice(0, 10);
      const nextCount = current.lastDay === yesterday ? (current.count || 0) + 1 : 1;
      localStorage.setItem(streakKey, JSON.stringify({ lastDay: dayKey, count: nextCount }));
      streakEl.textContent = String(nextCount);
    };

    const save = () => {
      localStorage.setItem(storageKey, JSON.stringify(Array.from(found)));
      updateStreak();
    };

    const setMessage = (text: string) => {
      messageEl.textContent = text;
    };

    const renderLetters = () => {
      lettersEl.innerHTML = puzzle.letters.split('').map((letter) => {
        const required = letter === puzzle.required;
        return `
          <span class="flex h-12 w-12 items-center justify-center rounded-md ${required ? 'bg-primary-600 text-white' : 'bg-sky-100 text-sky-950 dark:bg-sky-950 dark:text-sky-100'} font-mono text-xl font-bold shadow-sm">${letter}</span>
        `;
      }).join('');
    };

    const renderFound = () => {
      const words = Array.from(found).sort((a, b) => b.length - a.length || a.localeCompare(b));
      const score = words.reduce((sum, word) => sum + pointsFor(word), 0);
      scoreEl.textContent = String(score);
      foundCountEl.textContent = String(words.length);
      totalEl.textContent = String(answers.length);
      bestEl.textContent = best;
      progressEl.style.width = `${answers.length ? Math.round((words.length / answers.length) * 100) : 0}%`;
      foundEl.innerHTML = words.map((word) => `
        <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-3 py-2 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="font-mono font-medium">${word}</span>
          <span class="text-xs text-neutral-500">${isPangram(word) ? 'pangram' : `${pointsFor(word)} pt`}</span>
        </li>
      `).join('');
      emptyEl.classList.toggle('hidden', words.length > 0);
      if (words.length === answers.length && answers.length > 0) setMessage('Complete. You found every word today.');
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const word = normalizeLetters(input.value);
      input.value = '';
      if (word.length < 4) {
        setMessage('Use at least 4 letters.');
        return;
      }
      if (!word.includes(puzzle.required)) {
        setMessage(`${word} must include ${puzzle.required}.`);
        return;
      }
      if (!canBuild(word, puzzle.letters)) {
        setMessage(`${word} cannot be made from today's letters.`);
        return;
      }
      if (!answers.includes(word)) {
        setMessage(`${word} is not in this word list.`);
        return;
      }
      if (found.has(word)) {
        setMessage(`${word} was already found.`);
        return;
      }
      found.add(word);
      save();
      renderFound();
      setMessage(isPangram(word) ? `${word} uses every letter.` : `Added ${word}.`);
    });

    input.addEventListener('input', () => {
      const normalized = normalizeLetters(input.value);
      if (input.value !== normalized) input.value = normalized;
    });

    hintBtn.addEventListener('click', () => {
      const next = answers.find((word) => !found.has(word));
      if (!next) {
        setMessage('No hints left. You found everything.');
        return;
      }
      setMessage(`Hint: ${next.length} letters, starts with ${next[0]}.`);
    });

    shareBtn.addEventListener('click', async () => {
      const text = `Daily Scramble ${dayKey}: ${found.size}/${answers.length} words, ${scoreEl.textContent} points`;
      try {
        await navigator.clipboard.writeText(text);
        setMessage('Share result copied.');
      } catch {
        setMessage(text);
      }
    });

    dateEl.textContent = `Daily challenge for ${dayKey}`;
    renderLetters();
    renderFound();
    updateStreak();
    input.focus();
  }
</script>
