---
export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---
<span class="lexjolt-logo" aria-label="LexJolt">
  <svg class="lexjolt-logo-mark" viewBox="0 0 48 48" role="img" aria-hidden="true">
    <rect width="48" height="48" rx="10" fill="#0A66C2"></rect>
    <rect x="8" y="8" width="13" height="13" rx="3" fill="#FFFFFF"></rect>
    <rect x="27" y="7" width="13" height="13" rx="3" fill="#D7EBFF"></rect>
    <rect x="7" y="28" width="13" height="13" rx="3" fill="#B8DCFF"></rect>
    <rect x="27" y="27" width="13" height="13" rx="3" fill="#FFFFFF"></rect>
    <path d="M22 14h4m-5 20h5m-2-19 5 5m-7 14 6-6" stroke="#004182" stroke-width="2" stroke-linecap="round"></path>
    <text x="14.5" y="18" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="8" font-weight="800" fill="#004182">L</text>
    <text x="33.5" y="17" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="8" font-weight="800" fill="#004182">E</text>
    <text x="13.5" y="38" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="8" font-weight="800" fill="#004182">X</text>
    <text x="33.5" y="37" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="8" font-weight="800" fill="#004182">J</text>
  </svg>
  {!compact && <span class="lexjolt-logo-word">LexJolt</span>}
</span>

