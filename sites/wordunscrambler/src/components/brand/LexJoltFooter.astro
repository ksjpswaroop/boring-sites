---
import { brand } from '../../config/brand';
import LexJoltLogo from './LexJoltLogo.astro';

const year = new Date().getFullYear();
---
<footer class="lexjolt-footer">
  <div class="lexjolt-shell lexjolt-footer-grid">
    <div>
      <a href="/" class="lexjolt-footer-brand" aria-label="LexJolt home">
        <LexJoltLogo />
      </a>
      <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">{brand.tagline}</p>
      <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{brand.description}</p>
    </div>
    <div>
      <h2>Tools</h2>
      <a href="/word-unscrambler">Word Unscrambler</a>
      <a href="/word-finder">Word Finder</a>
    </div>
    <div>
      <h2>Games</h2>
      <a href="/anagram-rush">Anagram Rush</a>
      <a href="/daily">Daily Jolt</a>
    </div>
    <div>
      <h2>About</h2>
      <a href="/about">About</a>
      <a href="/faq">FAQ</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h2>Legal</h2>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/accessibility">Accessibility</a>
    </div>
  </div>
  <div class="lexjolt-shell lexjolt-footer-bottom">
    <p>© {year} LexJolt</p>
  </div>
</footer>

