---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';

const faqs = [
  { q: 'What is LexJolt?', a: 'LexJolt is a free word-learning and word-play platform with a word unscrambler, word finder, Anagram Rush, and Daily Jolt.' },
  { q: 'Does the solver work locally?', a: 'Yes. Word solving uses a bundled word list and local anagram index. Definition lookup is separate and only runs when you open a word detail.' },
  { q: 'Do I need an account?', a: 'No. LexJolt has no login, signup, payment, or premium tier.' },
  { q: 'Why are Unscrambler and Word Finder separate?', a: 'They share the same engine but support different intent: Unscrambler helps with a scrambled word, while Word Finder explores every word you can make from a letter set.' },
  { q: 'What is Daily Jolt?', a: 'Daily Jolt is one deterministic UTC word challenge per day. Progress and streaks are saved in your browser.' },
  { q: 'Are definitions always available?', a: 'No. Definitions are loaded on demand from a dictionary service when local fallback data is not available. If the lookup fails, the solver still works.' },
];
---
<LexJoltLayout
  title="FAQ"
  description="Frequently asked questions about LexJolt word tools and games."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  }}
>
  <article class="lexjolt-shell lexjolt-section">
    <div class="max-w-3xl">
      <p class="lexjolt-eyebrow">FAQ</p>
      <h1 class="lexjolt-h1 mt-2">Common questions</h1>
      <div class="mt-10 space-y-4">
        {faqs.map((f) => (
          <details class="lexjolt-card group">
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-bold">
              {f.q}
              <span class="text-primary-700 transition-transform group-open:rotate-180 dark:text-primary-200">v</span>
            </summary>
            <p class="mt-3 text-neutral-700 dark:text-neutral-300">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </article>
</LexJoltLayout>
