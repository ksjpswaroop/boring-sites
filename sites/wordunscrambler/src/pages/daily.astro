---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';
import DailyJolt from '../components/DailyJolt.astro';

const description = "Play Daily Jolt: today's free UTC word challenge with local streaks and shareable results.";
---
<LexJoltLayout
  title="Daily Jolt – Today's Free Word Challenge"
  description={description}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Daily Jolt',
    url: 'https://lexjolt.com/daily',
    description,
    applicationCategory: 'GameApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  }}
>
  <section class="lexjolt-shell lexjolt-section">
    <div class="mb-8 max-w-3xl">
      <p class="lexjolt-eyebrow">Daily word challenge</p>
      <h1 class="lexjolt-h1 mt-2">Daily Jolt</h1>
      <p class="lexjolt-lede mt-4">{description}</p>
    </div>
    <DailyJolt />
  </section>
</LexJoltLayout>
