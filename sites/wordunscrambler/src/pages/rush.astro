---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';
---
<LexJoltLayout title="Anagram Rush moved" description="The Anagram Rush route has moved to /anagram-rush." canonical="https://lexjolt.com/anagram-rush" noindex>
  <section class="lexjolt-shell lexjolt-section">
    <div class="lexjolt-card max-w-xl">
      <h1 class="text-3xl font-bold">Anagram Rush moved</h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">Use the production LexJolt route for Anagram Rush.</p>
      <a class="lexjolt-button lexjolt-button-primary mt-6" href="/anagram-rush">Go to Anagram Rush</a>
    </div>
  </section>
  <script is:inline>location.replace('/anagram-rush');</script>
</LexJoltLayout>
