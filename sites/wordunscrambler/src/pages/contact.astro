---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';
import { brand } from '../config/brand';
---
<LexJoltLayout title="Contact" description="Contact the LexJolt team.">
  <section class="lexjolt-shell lexjolt-section">
    <div class="max-w-2xl">
      <p class="lexjolt-eyebrow">Contact</p>
      <h1 class="lexjolt-h1 mt-2">Reach LexJolt</h1>
      <p class="lexjolt-lede mt-4">Send feedback, dictionary issues, accessibility concerns, or launch questions.</p>
      <div class="lexjolt-card mt-8">
        <p class="text-neutral-600 dark:text-neutral-300">Email</p>
        <a href={`mailto:${brand.email}`} class="mt-1 block text-xl font-bold text-primary-700 hover:underline dark:text-primary-200">{brand.email}</a>
      </div>
    </div>
  </section>
</LexJoltLayout>
