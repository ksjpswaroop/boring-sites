---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';
import Generator from '../components/Generator.astro';
import DailyJolt from '../components/DailyJolt.astro';
import { brand } from '../config/brand';

const description = 'LexJolt is a free word finder, word unscrambler, and anagram game hub. No signup, no paywall, instant local word solving.';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: brand.name,
    url: brand.origin,
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: brand.name,
    url: brand.origin,
    email: brand.email,
  },
];
---
<LexJoltLayout title="LexJolt – Free Word Finder, Unscrambler & Anagram Games" description={description} jsonLd={jsonLd}>
  <section class="lexjolt-shell lexjolt-hero">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-center">
      <div>
        <p class="lexjolt-eyebrow">Free word tools and games</p>
        <h1 class="lexjolt-h1 mt-3">{brand.tagline}</h1>
        <p class="lexjolt-lede mt-5 max-w-2xl">{brand.heroDescription}</p>
        <p class="mt-5 text-sm font-semibold text-neutral-600 dark:text-neutral-300">Free. No signup. Works instantly.</p>
      </div>
      <Generator
        mode="compact"
        heading="What can you make with these letters?"
        supportingText="Try A E T P R S, then open the full finder for every result."
      />
    </div>
  </section>

  <section class="lexjolt-shell lexjolt-section">
    <div class="grid gap-5 md:grid-cols-3">
      <a class="lexjolt-card block transition hover:border-primary-300 hover:bg-primary-50 dark:hover:bg-primary-950/40" href="/word-unscrambler">
        <p class="lexjolt-eyebrow">Unscramble</p>
        <h2 class="mt-2 text-xl font-bold">Unscramble a word</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Enter scrambled letters and discover valid words, meanings and pronunciations.</p>
        <span class="mt-5 inline-flex font-semibold text-primary-700 dark:text-primary-200">Unscramble letters</span>
      </a>
      <a class="lexjolt-card block transition hover:border-primary-300 hover:bg-primary-50 dark:hover:bg-primary-950/40" href="/word-finder">
        <p class="lexjolt-eyebrow">Word Finder</p>
        <h2 class="mt-2 text-xl font-bold">Find every possible word</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Enter the letters you have and explore all valid combinations.</p>
        <span class="mt-5 inline-flex font-semibold text-primary-700 dark:text-primary-200">Find words</span>
      </a>
      <a class="lexjolt-card block border-primary-200 transition hover:border-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/40" href="/anagram-rush">
        <p class="lexjolt-eyebrow">Anagram Rush</p>
        <h2 class="mt-2 text-xl font-bold">How fast can you think?</h2>
        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">You have 90 seconds. Build as many valid words as possible.</p>
        <span class="mt-5 inline-flex font-semibold text-primary-700 dark:text-primary-200">Play Anagram Rush</span>
      </a>
    </div>
  </section>

  <section class="lexjolt-band lexjolt-section">
    <div class="lexjolt-shell">
      <DailyJolt />
    </div>
  </section>

  <section class="lexjolt-shell lexjolt-section">
    <div class="max-w-3xl">
      <p class="lexjolt-eyebrow">Learning layer</p>
      <h2 class="lexjolt-h2 mt-2">Don't just find a word. Learn it.</h2>
      <p class="lexjolt-lede mt-4">
        Tap any result to inspect the definition, part of speech, pronunciation, and example usage. LexJolt keeps solving local and fast while word information loads only when you ask for it.
      </p>
    </div>
  </section>
</LexJoltLayout>
