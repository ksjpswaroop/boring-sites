---
import LexJoltLayout from '../layouts/LexJoltLayout.astro';
import { brand } from '../config/brand';
---
<LexJoltLayout title="About" description="Learn about LexJolt, a free collection of fast word tools and games.">
  <article class="lexjolt-shell lexjolt-section">
    <div class="max-w-3xl">
      <p class="lexjolt-eyebrow">About LexJolt</p>
      <h1 class="lexjolt-h1 mt-2">Fast word tools for finding, learning, and playing.</h1>
      <div class="mt-8 space-y-5 text-lg leading-8 text-neutral-700 dark:text-neutral-300">
        <p>LexJolt is a free collection of fast word tools and games designed to help people discover words, understand them, and have fun with language.</p>
        <p>The product is English-first, local-first, and privacy-conscious. The solver runs in your browser from a bundled word list, so word results stay instant without accounts, payments, or a backend.</p>
        <p>LexJolt is useful for students, learners, writers, puzzle fans, and word-game players who want a polished utility that also creates a reason to return tomorrow.</p>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {['Free to use', 'No account', 'No payment', 'Local word solver', 'Definitions on demand', 'Built for daily play'].map((item) => (
          <div class="lexjolt-card text-sm font-semibold text-neutral-700 dark:text-neutral-200">{item}</div>
        ))}
      </div>
      <p class="mt-8 text-sm text-neutral-500">Contact: <a class="font-semibold text-primary-700 dark:text-primary-200" href={`mailto:${brand.email}`}>{brand.email}</a></p>
    </div>
  </article>
</LexJoltLayout>
