---
/**
 * The main IP display card. Shows the requester's public IP,
 * detected server-side at request time (no JS required).
 *
 * The IP comes from x-forwarded-for via the shared lib/request module.
 * This card is server-rendered for accessibility and progressive enhancement.
 */
import { getRequestIp } from '../lib/request';

const ip = getRequestIp(Astro.request);
const isValid = ip !== 'unknown' && ip.length > 0;
---
<section class="card">
  <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Your public IP address</h2>
  <div class="mt-3 flex flex-col items-start justify-between gap-3 sm:flex-row sm:items-center">
    <code
      id="ip-display"
      class="break-all font-mono text-3xl font-bold tracking-tight sm:text-4xl"
      data-ip={ip}
    >
      {ip}
    </code>
    <button
      id="copy-ip-btn"
      type="button"
      class="btn btn-secondary shrink-0"
      data-ip={ip}
      disabled={!isValid}
      aria-label="Copy IP address to clipboard"
    >
      Copy
    </button>
  </div>
  <p class="mt-3 text-xs text-neutral-500 dark:text-neutral-500">
    Detected server-side from your connection's source address. <a href="/learn/what-is-an-ip-address" class="underline hover:no-underline">What is an IP address?</a>
  </p>
</section>

<script is:inline define:vars={{ ip, isValid }}>
  const btn = document.getElementById('copy-ip-btn');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(ip);
      const orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = orig; }, 1500);
      window.plausible?.('copy_ip');
    } catch {
      // Clipboard blocked; do nothing
    }
  });
</script>
