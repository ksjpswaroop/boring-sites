---
/**
 * Phone number generator UI. Country + area code + count → list of fake numbers.
 */
import { COUNTRIES } from '../lib/generator';
---
<div class="card border-2 border-amber-300 bg-amber-50 dark:border-amber-700 dark:bg-amber-950/30">
  <div class="flex items-start gap-3">
    <span class="text-2xl">⚠️</span>
    <div>
      <p class="font-semibold text-amber-900 dark:text-amber-200">These numbers are randomly generated. They are not real and are not assigned to any phone or person.</p>
      <p class="mt-1 text-sm text-amber-800 dark:text-amber-300">
        <strong>Do not use these for fraud, harassment, or bypassing verification systems that require real numbers.</strong>
      </p>
    </div>
  </div>
</div>

<div class="card mt-6">
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="country-select" class="block text-sm font-medium">Country</label>
      <select
        id="country-select"
        class="mt-1 block w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-base dark:border-neutral-700 dark:bg-neutral-900"
      >
        {Object.values(COUNTRIES).map((c) => (
          <option value={c.code}>{c.flag} {c.name}</option>
        ))}
      </select>
    </div>
    <div id="area-code-row" class="hidden">
      <label for="area-code-select" class="block text-sm font-medium">Area code</label>
      <select
        id="area-code-select"
        class="mt-1 block w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-base dark:border-neutral-700 dark:bg-neutral-900"
      >
        <option value="">🎲 Random area code</option>
        {/* Populated client-side */}
      </select>
    </div>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    <div>
      <label for="count-input" class="block text-sm font-medium">How many numbers</label>
      <input
        type="number"
        id="count-input"
        min="1"
        max="100"
        value="10"
        class="mt-1 block w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-base dark:border-neutral-700 dark:bg-neutral-900"
      />
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-3">
    <button type="button" id="generate-btn" class="btn btn-primary px-6 py-3 text-base">
      📞 Generate
    </button>
    <button type="button" id="copy-all-btn" class="btn btn-secondary" disabled>
      Copy all
    </button>
    <p id="result-count" class="ml-auto text-sm text-neutral-500" aria-live="polite"></p>
  </div>
</div>

<div class="mt-8">
  <h2 class="text-sm font-medium text-neutral-500 dark:text-neutral-400">Generated numbers</h2>
  <ul id="results" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"></ul>
  <p id="empty-state" class="mt-8 hidden text-center text-sm text-neutral-500">No numbers generated yet.</p>
</div>

<script>
  // @ts-nocheck
  const $ = (s) => document.querySelector(s);
  const countrySelect = $('#country-select');
  const areaCodeRow = $('#area-code-row');
  const areaCodeSelect = $('#area-code-select');
  const countInput = $('#count-input');
  const generateBtn = $('#generate-btn');
  const copyAllBtn = $('#copy-all-btn');
  const resultsEl = $('#results');
  const resultCountEl = $('#result-count');
  const emptyEl = $('#empty-state');

  const COUNTRIES = {
    US: { name: 'United States', flag: '🇺🇸', hasAreaCodes: true, areaCodes: ['201', '202', '203', '205', '206', '207', '208', '209', '210', '212', '213', '214', '215', '216', '217', '218', '219', '301', '302', '303', '304', '305', '307', '308', '309', '310', '312', '313', '314', '315', '316', '317', '318', '319', '320', '321', '323', '325', '330', '331', '334', '336', '339', '347', '351', '352', '360', '361', '386', '401', '402', '404', '405', '406', '407', '408', '409', '410', '412', '413', '414', '415', '417', '419', '423', '425', '430', '432', '434', '440', '443', '469', '478', '479', '480', '484', '501', '502', '503', '504', '505', '507', '508', '509', '510', '512', '513', '515', '516', '517', '518', '520', '530', '540', '551', '559', '561', '562', '563', '564', '567', '570', '571', '573', '574', '580', '585', '586', '601', '602', '603', '605', '606', '607', '608', '609', '610', '612', '614', '615', '616', '617', '618', '619', '620', '623', '626', '630', '631', '636', '641', '646', '650', '651', '660', '661', '662', '678', '682', '701', '702', '703', '704', '706', '707', '708', '712', '713', '714', '715', '716', '717', '718', '719', '720', '724', '727', '731', '732', '734', '740', '754', '757', '760', '763', '765', '770', '772', '773', '774', '775', '781', '785', '786', '801', '802', '803', '804', '805', '806', '808', '810', '812', '813', '814', '815', '816', '817', '818', '828', '830', '831', '832', '843', '845', '847', '848', '850', '856', '857', '858', '859', '860', '862', '863', '864', '865', '870', '878', '901', '903', '904', '906', '907', '908', '909', '910', '912', '913', '914', '915', '916', '917', '918', '919', '920', '925', '928', '931', '936', '937', '940', '941', '947', '949', '951', '952', '954', '956', '970', '971', '972', '973', '978', '980', '985', '989'] },
    UK: { name: 'United Kingdom', flag: '🇬🇧', hasAreaCodes: false },
    CA: { name: 'Canada', flag: '🇨🇦', hasAreaCodes: true, areaCodes: ['204', '226', '236', '249', '250', '289', '306', '343', '365', '403', '416', '418', '431', '437', '438', '450', '506', '514', '519', '548', '579', '581', '587', '604', '613', '639', '647', '672', '705', '709', '742', '778', '780', '782', '807', '819', '825', '867', '873', '902', '905'] },
    AU: { name: 'Australia', flag: '🇦🇺', hasAreaCodes: false },
    DE: { name: 'Germany', flag: '🇩🇪', hasAreaCodes: false },
    FR: { name: 'France', flag: '🇫🇷', hasAreaCodes: false },
    GENERIC: { name: 'Generic', flag: '🌐', hasAreaCodes: false },
  };

  function pattern(country, area) {
    if (country === 'US' || country === 'CA') {
      const ac = area || (COUNTRIES[country].areaCodes[Math.floor(Math.random() * COUNTRIES[country].areaCodes.length)]);
      const mid = String(Math.floor(Math.random() * 1000)).padStart(3, '0');
      const end = String(Math.floor(Math.random() * 10000)).padStart(4, '0');
      return `(${ac}) ${mid}-${end}`;
    } else if (country === 'UK') {
      const isMobile = Math.random() < 0.7;
      if (isMobile) {
        const rest = String(Math.floor(Math.random() * 9_000_000)).padStart(7, '0');
        return `+44 7${rest.slice(0, 2)} ${rest.slice(2, 6)} ${rest.slice(6)}`;
      } else {
        const num = String(Math.floor(Math.random() * 9_000_000)).padStart(7, '0');
        return `+44 20 ${num.slice(0, 4)} ${num.slice(4)}`;
      }
    } else if (country === 'AU') {
      const mid = String(Math.floor(Math.random() * 1000)).padStart(3, '0');
      const end = String(Math.floor(Math.random() * 10000)).padStart(4, '0');
      return `+61 4${Math.floor(Math.random() * 10)} ${mid} ${end}`;
    } else if (country === 'DE') {
      const isMobile = Math.random() < 0.7;
      if (isMobile) {
        const mid = String(Math.floor(Math.random() * 1000)).padStart(3, '0');
        const end = String(Math.floor(Math.random() * 10000)).padStart(4, '0');
        return `+49 1${Math.floor(Math.random() * 10)} ${mid} ${end}`;
      }
      return `+49 30 ${String(Math.floor(Math.random() * 9_000_000)).padStart(7, '0')}`;
    } else if (country === 'FR') {
      const isMobile = Math.random() < 0.7;
      const start = isMobile ? '6' : '1';
      const d = Array.from({ length: 8 }, () => Math.floor(Math.random() * 10));
      return `+33 ${start} ${d.slice(0, 2).join('')} ${d.slice(2, 4).join('')} ${d.slice(4, 6).join('')} ${d.slice(6, 8).join('')}`;
    } else {
      const d = Array.from({ length: 10 }, () => Math.floor(Math.random() * 10));
      return d.join('');
    }
  }

  function updateAreaCodeVisibility() {
    const country = COUNTRIES[countrySelect.value];
    if (country.hasAreaCodes) {
      areaCodeRow.classList.remove('hidden');
      // Populate area codes
      areaCodeSelect.innerHTML = '<option value="">🎲 Random area code</option>' +
        country.areaCodes.map((c) => `<option value="${c}">${c}</option>`).join('');
    } else {
      areaCodeRow.classList.add('hidden');
    }
  }

  let currentNumbers = [];

  function generate() {
    const country = countrySelect.value;
    const count = Math.max(1, Math.min(100, parseInt(countInput.value, 10) || 10));
    const area = areaCodeSelect.value || undefined;
    const numbers = [];
    for (let i = 0; i < count; i++) {
      numbers.push(pattern(country, area));
    }
    currentNumbers = numbers;
    resultCountEl.textContent = `${count} number${count === 1 ? '' : 's'} generated`;
    emptyEl.classList.add('hidden');
    copyAllBtn.disabled = false;
    resultsEl.innerHTML = numbers.map((n) => `
      <li class="flex items-center justify-between rounded-md border border-neutral-200 bg-white px-4 py-2.5 font-mono text-sm dark:border-neutral-800 dark:bg-neutral-900">
        <span>${n}</span>
        <button class="copy-btn text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100" data-number="${n}" aria-label="Copy ${n}">Copy</button>
      </li>
    `).join('');

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const n = btn.getAttribute('data-number');
        try {
          await navigator.clipboard.writeText(n);
          const orig = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = orig; }, 1200);
        } catch {}
      });
    });
    window.plausible?.('generate', { props: { country, count } });
  }

  countrySelect.addEventListener('change', updateAreaCodeVisibility);
  generateBtn.addEventListener('click', generate);
  copyAllBtn.addEventListener('click', async () => {
    if (currentNumbers.length === 0) return;
    try {
      await navigator.clipboard.writeText(currentNumbers.join('\n'));
      const orig = copyAllBtn.textContent;
      copyAllBtn.textContent = 'Copied all!';
      setTimeout(() => { copyAllBtn.textContent = orig; }, 1500);
      window.plausible?.('copy_all');
    } catch {}
  });

  // Restore last
  const last = localStorage.getItem('boring-sites:phonegen:country');
  if (last && COUNTRIES[last]) countrySelect.value = last;
  countrySelect.addEventListener('change', () => localStorage.setItem('boring-sites:phonegen:country', countrySelect.value));
  updateAreaCodeVisibility();
  generate();
</script>
