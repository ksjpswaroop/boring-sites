---
import Layout from '@boring-sites/design/Layout.astro';
const siteName = 'Phone Number Generator';
const faqs = [
  { q: 'Are these real phone numbers?', a: 'No. They follow the correct format (US numbers have the right 10-digit structure, UK numbers include +44, etc.) but are not assigned to any phone, person, or carrier. They are randomly generated format placeholders.' },
  { q: 'Can I use these for verification bypass / SMS verification?', a: 'No. Most SMS verification services detect generated numbers anyway. Using fake numbers to bypass verification is fraud in most jurisdictions and is explicitly prohibited by our terms.' },
  { q: 'Can I use these for testing?', a: 'Yes — that\'s exactly what they\'re for. Test databases, forms, mockups, documentation, screenshots, training data. Anywhere you need a plausible-looking number that isn\'t a real one.' },
  { q: 'Why do you have a "not real" banner?', a: 'Because most "phone number generator" sites are spammy or sketchy. We want to be unambiguously clear about what these numbers are and are not. Trust is the differentiator.' },
  { q: 'How many area codes do you support?', a: 'For V1, we support all 300+ US area codes and 40+ Canadian area codes. UK, Australia, Germany, and France use country-wide formats (no area codes in the US sense).' },
  { q: 'Will you add E.164 / international format?', a: 'It\'s on the V1.1 roadmap. For now, numbers are in the country\'s national format.' },
];
---
<Layout
  title="FAQ"
  description="Frequently asked questions about the Phone Number Generator."
  siteName={siteName}
  customDisclaimer="Numbers are NOT real. Do not use for fraud, harassment, or verification bypass."
  jsonLd={{
    type: 'FAQPage',
    data: {
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  }}
>
  <article class="container-prose py-12">
    <h1 class="text-4xl font-bold">FAQ</h1>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">Common questions about the Phone Number Generator.</p>
    <div class="mt-10 space-y-4">
      {faqs.map((f) => (
        <details class="group rounded-lg border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
          <summary class="cursor-pointer text-lg font-semibold flex items-center justify-between">
            {f.q}
            <span class="text-neutral-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-neutral-700 dark:text-neutral-300">{f.a}</p>
        </details>
      ))}
    </div>
  </article>
</Layout>
